<%- include('../partials/head') %><body><%- include('../partials/nav') %><main class="shell page-wrap"><div class="toolbar"><div class="page-head"><div class="eyebrow">Host dashboard</div><h1 class="page-title">Your listings</h1><p class="page-subtitle">Manage the places you’ve shared with guests.</p></div><a class="button" href="/host/add-home">＋ Add a listing</a></div>
<% if (registeredHome.length) { %><div class="cards"><% registeredHome.forEach(home => { %><article class="listing-card"><a href="/homes/<%= home._id %>"><div class="card-image"><img src="<%= typeof home.photo === 'string' && home.photo.trim() ? (home.photo.startsWith('/' ) ? home.photo : '/' + home.photo) : '/images/house1.png' %>" alt="<%= home.houseName %>"></div></a><div class="card-body"><div class="card-top"><h2 class="card-title"><%= home.houseName %></h2><span class="rating">★ <%= home.rating %></span></div><p class="location">⌖ <%= home.Location %></p><div class="card-bottom"><div class="price">₹<%= Number(home.Price).toLocaleString('en-IN') %> <span>/ night</span></div><a class="text-link" href="/homes/<%= home._id %>">Preview →</a></div><div class="host-card-actions"><a class="button button-light button-small" href="/host/edit-home/<%= home._id %>?editing=true">Edit listing</a><form action="/host/delete-home/<%= home._id %>" method="POST" onsubmit="return confirm('Delete this listing? This cannot be undone.')"><button type="submit" class="button button-danger button-small">Delete</button></form></div></div></article><% }) %></div><% } else { %><div class="empty-state"><div class="empty-icon">⌂</div><h2>Your host dashboard starts here</h2><p>Create your first listing and welcome your next guest.</p><a class="button" href="/host/add-home">List your place</a></div><% } %></main><%- include('../partials/footer') %></body></html>




