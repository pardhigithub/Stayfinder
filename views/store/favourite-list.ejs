<%- include('../partials/head') %><body><%- include('../partials/nav') %><main class="shell page-wrap"><div class="page-head"><div class="eyebrow">Your shortlist</div><h1 class="page-title">Saved stays</h1><p class="page-subtitle">Keep the places you love close at hand.</p></div>
<% if (favouriteHomes.length) { %><div class="cards"><% favouriteHomes.forEach(home => { if(home) { %><article class="listing-card"><a href="/homes/<%= home._id %>"><div class="card-image"><img src="<%= typeof home.photo === 'string' && home.photo.trim() ? (home.photo.startsWith('/' ) ? home.photo : '/' + home.photo) : '/images/house1.png' %>" alt="<%= home.houseName %>" loading="lazy"></div></a><div class="card-body"><div class="card-top"><h2 class="card-title"><%= home.houseName %></h2><span class="rating">★ <%= home.rating %></span></div><p class="location">⌖ <%= home.Location %></p><div class="card-bottom"><div class="price">₹<%= Number(home.Price).toLocaleString('en-IN') %> <span>/ night</span></div><a class="text-link" href="/homes/<%= home._id %>">View →</a></div><form action="/favourite-list/delete/<%= home._id %>" method="POST" style="margin-top:13px"><button type="submit" class="button button-light button-small">Remove from saved</button></form></div></article><% } }) %></div><% } else { %><div class="empty-state"><div class="empty-icon">♡</div><h2>Your saved places live here</h2><p>Tap the heart on a stay to keep it on your shortlist.</p><a class="button" href="/homes">Explore stays</a></div><% } %></main><%- include('../partials/footer') %></body></html>



