<%- include('../partials/head') %><body><%- include('../partials/nav') %><main class="shell page-wrap"><div class="page-head"><div class="eyebrow">Your journeys</div><h1 class="page-title">Your trips</h1><p class="page-subtitle">All the details for the places you’ve reserved.</p></div>
<% if (bookings.length) { %><% bookings.forEach(booking => { if (booking.home) { %><article class="booking-card"><img src="<%= typeof booking.home.photo === 'string' && booking.home.photo.trim() ? (booking.home.photo.startsWith('/' ) ? booking.home.photo : '/' + booking.home.photo) : '/images/house1.png' %>" alt="<%= booking.home.houseName %>"><div><h3><a href="/homes/<%= booking.home._id %>"><%= booking.home.houseName %></a></h3><p>⌖ <%= booking.home.Location %></p><p><%= new Date(booking.checkIn).toLocaleDateString() %> – <%= new Date(booking.checkOut).toLocaleDateString() %> · <%= booking.guests %> guest<%= booking.guests>1?'s':'' %></p></div><div class="booking-total">₹<%= Number(booking.totalPrice).toLocaleString('en-IN') %><p class="sort-note">Total stay</p></div></article><% } }) %><% } else { %><div class="empty-state"><div class="empty-icon">✈</div><h2>No trips booked yet</h2><p>When you find the right place, your reservation details will show up here.</p><a class="button" href="/homes">Explore stays</a></div><% } %></main><%- include('../partials/footer') %></body></html>



