<%- include('../partials/head') %><body><%- include('../partials/nav') %>
<main class="shell page-wrap"><div class="two-col"><div><img class="detail-image" src="<%= typeof home.photo === 'string' && home.photo.trim() ? (home.photo.startsWith('/' ) ? home.photo : '/' + home.photo) : '/images/house1.png' %>" alt="<%= home.houseName %>"><div class="page-head" style="margin-top:24px"><div class="eyebrow">A place to unwind</div><h1 class="detail-title"><%= home.houseName %></h1><p class="detail-info">⌖ <%= home.Location %> &nbsp; · &nbsp; ★ <%= home.rating %> / 5</p><h2>About this stay</h2><p class="detail-description"><%= home.description || 'A comfortable place to settle in and explore the neighborhood.' %></p></div></div>
<aside class="booking-box"><p class="price">₹<%= Number(home.Price).toLocaleString('en-IN') %> <span>/ night</span></p><p class="sort-note">Plan your stay</p><% if (bookingError) { %><div class="error-box" role="alert"><%= bookingError %></div><% } %>
<form action="/homes/<%= home._id %>/book" method="POST"><div class="field"><label for="checkIn">Check in</label><input type="date" id="checkIn" name="checkIn" min="<%= new Date().toISOString().slice(0,10) %>" required></div><div class="field"><label for="checkOut">Check out</label><input type="date" id="checkOut" name="checkOut" min="<%= new Date().toISOString().slice(0,10) %>" required></div><div class="field"><label for="guests">Guests</label><select id="guests" name="guests"><% for(let n=1;n<=16;n++){ %><option value="<%= n %>"><%= n %> guest<%= n>1?'s':'' %></option><% } %></select></div><button class="button" style="width:100%" type="submit"><%= isLoggedIn ? 'Reserve your stay' : 'Log in to reserve' %></button></form><p class="sort-note" style="text-align:center;margin:13px 0 0">You won’t be charged yet</p></aside></div></main>
<%- include('../partials/footer') %></body></html>



