<%- include('../partials/head') %><body><%- include('../partials/nav') %>
<main class="shell page-wrap"><div class="toolbar"><div class="page-head"><div class="eyebrow">Explore</div><h1 class="page-title">Find your next stay</h1><p class="page-subtitle"><%= registeredHome.length %> places to make yourself at home</p></div><form class="search-inline" action="/homes" method="GET"><input type="search" name="search" value="<%= search || '' %>" placeholder="Search a place or destination" aria-label="Search listings"><button class="button button-small">Search</button></form></div>
<% if (registeredHome.length) { %><div class="cards"><% registeredHome.forEach(home => { %><article class="listing-card"><div class="card-image"><a href="/homes/<%= home._id %>"><img src="<%= typeof home.photo === 'string' && home.photo.trim() ? (home.photo.startsWith('/' ) ? home.photo : '/' + home.photo) : '/images/house1.png' %>" alt="<%= home.houseName %>" loading="lazy"></a><% if (isLoggedIn && user.userType === 'guest') { %><%- include('../partials/favourite', {home}) %><% } %></div><div class="card-body"><div class="card-top"><h2 class="card-title"><%= home.houseName %></h2><span class="rating">★ <%= home.rating %></span></div><p class="location">⌖ <%= home.Location %></p><div class="card-bottom"><div class="price">₹<%= Number(home.Price).toLocaleString('en-IN') %> <span>/ night</span></div><a class="text-link" href="/homes/<%= home._id %>">View details →</a></div></div></article><% }) %></div><% } else { %><div class="empty-state"><div class="empty-icon">⌕</div><h2>No stays found</h2><p>Try another place name or clear your search.</p><a class="button button-light" href="/homes">Clear search</a></div><% } %></main>
<%- include('../partials/footer') %></body></html>


