<header class="site-header"><div class="shell nav-inner">
  <a class="brand" href="/" aria-label="Stayfinder home"><span class="brand-mark">s</span><span class="brand-name">stayfinder</span></a>
  <nav class="nav-links" id="site-navigation" aria-label="Main navigation">
    <a href="/homes">Explore</a>
    <% if (isLoggedIn && user && user.userType === 'guest') { %><a href="/bookings">My trips</a><a href="/favourite-list">Saved stays</a><% } %>
    <% if (isLoggedIn && user && user.userType === 'host') { %><a href="/host/host-home-list">My listings</a><a href="/host/add-home">List your place</a><% } %>
  </nav>
  <div class="nav-actions">
    <% if (isLoggedIn) { %><span class="sort-note">Hi, <%= user.firstName || 'there' %></span><form action="/logout" method="POST"><button class="button button-light button-small" type="submit">Log out</button></form><% } else { %><a class="text-link" href="/login">Log in</a><a class="button button-small" href="/signup">Get started</a><% } %>
    <button class="button button-light button-small mobile-menu" type="button" aria-label="Open navigation" aria-expanded="false" onclick="const n=document.getElementById('site-navigation');n.classList.toggle('open');this.setAttribute('aria-expanded',n.classList.contains('open'))">☰</button>
  </div>
</div></header>

